<Window x:Class="fitnessTracker24_25.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:fitnessTracker24_25"
        mc:Ignorable="d"
        Title="FitnessTracker24-25"
        Height="450" 
        Width="800"
        Icon="fitnessTracker.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height ="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Menu Grid.Row="0">
            <MenuItem Header="Importar" Name="importarDatos" Click="MenuItem_Click"/>
            <MenuItem Header="Exportar" Name ="exportarDatos" Click="MenuItem_Click"/>
            <MenuItem Header="Vaciar" Name="vaciarDatos" Click="MenuItem_Click"/>
        </Menu>
        
        <TabControl Grid.Row="1">
            <TabItem Header="Ejercicios">
                <Grid Name="EjerciciosGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Name="DataGridEjercicio"
                              Grid.Row="0" 
                              SelectionMode="Single"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              MouseDoubleClick="DataGridEjercicio_MouseDoubleClick"
                              SelectionChanged="DataGridEjercicio_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn  Width="*" Header="Nombre" Binding="{Binding NombreEjercicio}"/>
                            <DataGridTextColumn  Width="2*" Header="Descripcion" Binding="{Binding DescripcionEjercicio}"/>
                            <DataGridTextColumn  Width="*" Header="Grupo Muscular" Binding="{Binding GruposMuscularesString}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <StackPanel Name="BotonesStackPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        
                        <Button Name="AddButton"
                                Content="Añadir"
                                Margin="5"
                                Click="AddButton_Click"/>
                        
                        <Button Name="EditButton"
                                Content="Modificar"
                                Margin="5"
                                IsEnabled="False"
                                Click="EditButton_Click"/>
                        
                        <Button Name="DeleteButton"
                                Content="Eliminar"
                                Margin="5"
                                IsEnabled="False"
                                Click="DeleteButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Daily Insights">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Selección de Fecha -->
                        <RowDefinition Height="*"/>
                        <!-- Gráfico -->
                    </Grid.RowDefinitions>

                    <!-- Selección de Fecha -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Grid.Row="0" 
                                Margin="10">
                        <Button Name="AnteriorButton" 
                                Content="Anterior" 
                                Margin="5" 
                                Click="AnteriorButton_Click"/>
                        <DatePicker Name="DatePickerGrafico"
                                    Margin="5"
                                    SelectedDateChanged="DatePickerGrafico_SelectedDateChanged"/>
                        <Button Name="SiguienteButton"
                                Content="Siguiente"
                                Margin="5" 
                                Click="SiguienteButton_Click"/>
                    </StackPanel>

                    <!-- Gráfico -->
                    <Canvas Name="CanvasGrafico" Grid.Row="1" Background="LightGray" Margin="10"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
